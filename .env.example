# Copy to .env and fill in via scripts/provision-acm-hotels-deploy.sh (issue #3).
# Secrets (DEPLOY_SSH_KEY, GHCR_TOKEN, SANITY_REVALIDATE_SECRET) are never
# stored here — they live only in GitHub Actions secrets / the container's
# runtime env.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Shared secret configured on the Sanity webhook (project settings > API >
# Webhooks) that POSTs to /api/revalidate on publish — see issue #6.
SANITY_REVALIDATE_SECRET=

# Deploy target, recorded for the wizard's re-run convenience.
SSH_HOST=
SSH_USER=
DOMAIN=
